{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puniaassociates.site/schemas/legal-resource.schema.json",
  "title": "Punia Associates Legal Resource",
  "type": "object",
  "required": ["resourceId", "resourceType", "title", "jurisdictionType", "jurisdictionName", "officialRecordUrl", "verificationStatus", "publicationStatus"],
  "properties": {
    "resourceId": {"type": "string", "minLength": 1},
    "resourceType": {"type": "string", "enum": ["CONSTITUTION", "BARE_ACT", "STATE_ACT", "UT_ACT", "RULE", "REGULATION", "NOTIFICATION", "ORDER", "ORDINANCE", "CIRCULAR", "FORM", "LEGAL_BOOK", "LEGAL_PDF", "JUDGMENT", "LEGAL_ARTICLE"]},
    "title": {"type": "string", "minLength": 1},
    "shortTitle": {"type": ["string", "null"]},
    "actNumber": {"type": ["string", "null"]},
    "actYear": {"type": ["integer", "null"]},
    "jurisdictionType": {"type": "string", "enum": ["CENTRAL", "STATE", "UNION_TERRITORY"]},
    "jurisdictionName": {"type": "string"},
    "subjectCategory": {"type": ["string", "null"]},
    "subCategory": {"type": ["string", "null"]},
    "legalStatus": {"type": "string", "enum": ["IN_FORCE", "PARTIALLY_IN_FORCE", "REPEALED", "HISTORICAL_OR_TRANSITIONAL", "NOT_YET_IN_FORCE", "UNKNOWN", "UNDER_REVIEW"]},
    "commencementDate": {"type": ["string", "null"], "format": "date"},
    "amendmentStatus": {"type": ["string", "null"]},
    "consolidationAsOf": {"type": ["string", "null"], "format": "date"},
    "officialRecordUrl": {"type": "string", "format": "uri"},
    "officialPdfUrl": {"type": ["string", "null"], "format": "uri"},
    "localFilePath": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "language": {"type": ["string", "null"]},
    "sourceAgency": {"type": ["string", "null"]},
    "sourceCheckedAt": {"type": ["string", "null"], "format": "date-time"},
    "lastVerifiedAt": {"type": ["string", "null"], "format": "date-time"},
    "reviewedBy": {"type": ["string", "null"]},
    "verificationStatus": {"type": "string", "enum": ["UNVERIFIED", "SOURCE_CHECKED", "LEGAL_REVIEWED", "NEEDS_EDITOR_VERIFICATION", "NEEDS_LEGAL_REVIEW", "SOURCE_UNAVAILABLE"]},
    "publicationStatus": {"type": "string", "enum": ["DRAFT", "PENDING_REVIEW", "PUBLISHED", "ARCHIVED", "REJECTED"]},
    "displayNotice": {"type": ["string", "null"]},
    "reusePermissionStatus": {"type": "string", "enum": ["LINK_ONLY", "PERMISSION_CHECK_PENDING", "REUSE_CONFIRMED", "LICENSED", "PUBLIC_DOMAIN_CONFIRMED", "DO_NOT_REHOST" ]},
    "versionOfResourceId": {"type": ["string", "null"]},
    "supersedesResourceId": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
